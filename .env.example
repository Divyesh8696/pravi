# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Replica Set (Transactions support enabled)
MONGODB_URI=mongodb://127.0.0.1:27017/municipal_swm?replicaSet=rs0

# JWT & Authentication
JWT_SECRET=super_secret_jwt_key_municipal_swm_2026_secure
JWT_EXPIRES_IN=8h

# File Storage
STORAGE_DIR=./storage

# Geographic Center (Gandhinagar Demo City)
CITY_CODE=DEMO-CITY
CITY_NAME=Gandhinagar Municipal Operations Demo
CITY_CENTER_LAT=23.2156
CITY_CENTER_LNG=72.6369
CITY_DEFAULT_ZOOM=12

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
